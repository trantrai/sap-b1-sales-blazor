<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý đơn hàng bán — SAP B1</title>
    <base href="/" />
    <link href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/tailwind.css" />
    <link rel="stylesheet" href="@Assets["SalesWeb.BlazorServer.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    @* Tắt prerender: circuit interactive được thiết lập ngay từ đầu nên
       JS interop + ProtectedSessionStorage hoạt động như bản WebAssembly,
       tránh lỗi "JavaScript interop calls cannot be issued" khi prerender. *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <div id="blazor-error-ui" data-nosnippet>
        Đã xảy ra lỗi. Vui lòng tải lại trang.
        <a href="." class="reload">Tải lại</a>
        <span class="dismiss">🗙</span>
    </div>
    <script src="js/imask.min.js"></script>
    <script src="js/Sortable.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
