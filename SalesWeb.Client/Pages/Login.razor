@page "/login"
@layout EmptyLayout
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Đăng nhập — Sale Order</PageTitle>

<div class="fm-login fm-app-root">
    <div class="fm-login__panel">
        <div class="fm-login__brand">
            <div class="fm-logo__badge" style="width:52px; height:52px; font-size:18px; margin:0 auto 10px">
                SO
            </div>
            <h1 class="fm-card__title" style="text-align:center">Sale Order</h1>
            <p class="fm-card__desc" style="text-align:center; margin:0">
                Hệ thống quản lý đơn hàng bán · SAP B1 HANA
            </p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="fm-alert fm-alert--error" role="alert">
                <div><b>Đăng nhập thất bại</b>@error</div>
            </div>
        }

        <form @onsubmit="Submit" @onsubmit:preventDefault="true">
            <div class="fm-field">
                <label class="fm-label">Tên đăng nhập</label>
                <FluentTextInput @bind-Value="username" AutoComplete="username" Style="width:100%" />
            </div>
            <div class="fm-field">
                <label class="fm-label">Mật khẩu</label>
                <FluentTextInput TextInputType="TextInputType.Password" @bind-Value="password"
                                 AutoComplete="current-password" Style="width:100%" />
            </div>
            <div class="fm-field">
                <label class="fm-label">Cơ sở dữ liệu</label>
                <FluentSelect TValue="string" TOption="DbEntry"
                              Items="@databases" OptionText="@(d => string.IsNullOrWhiteSpace(d.Name) || d.Name == d.Code ? d.Code : $"{d.Name} ({d.Code})")" OptionValue="@(d => d.Code)"
                              @bind-Value="companyDb" Style="width:100%" />
                <div class="fm-hint">Chọn CompanyDB SAP B1 để làm việc trong phiên này</div>
            </div>
            <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit"
                          Loading="busy" Disabled="busy" Style="width:100%; padding:10px">
                @(busy ? "Đang đăng nhập…" : "Đăng nhập")
            </FluentButton>
        </form>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string companyDb = "";
    private List<DbEntry> databases = new();
    private string error = "";
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo("/");
        try
        {
            // P2-2: chỉ prefill demo credentials khi server đang ở mock mode
            var health = await Api.GetHealthAsync();
            if (health?.B1Mode == "mock")
            {
                username = "admin";
                password = "admin123";
            }
            var d = await Api.GetDatabasesAsync();
            if (d is not null)
            {
                databases = d.Databases;
                companyDb = d.Default;
            }
        }
        catch { /* không tải được danh sách DB -> vẫn cho đăng nhập DB mặc định */ }
    }

    private async Task Submit()
    {
        error = "";
        busy = true;
        try
        {
            await Auth.LoginAsync(username, password, companyDb);
            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
