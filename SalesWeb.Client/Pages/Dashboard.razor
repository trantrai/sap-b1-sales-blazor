@page "/dashboard"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Dashboard — Sale Order</PageTitle>

<div class="fm-card" style="margin-bottom:14px">
    <h2 class="fm-card__title">Dashboard kinh doanh</h2>
    <p class="fm-card__desc" style="margin-bottom:0">Tổng quan đơn hàng và doanh số — dữ liệu từ SAP B1.</p>
</div>

@if (loading)
{
    <FluentProgressRing />
}
else if (stats is null)
{
    <div class="fm-alert fm-alert--error">@error</div>
}
else
{
    @* KPI cards *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:14px">
        <div class="fm-card" style="margin:0;padding:16px;text-align:center">
            <div style="font-size:12px;color:var(--fm-text-2)">Tổng đơn hàng</div>
            <div style="font-size:28px;font-weight:700;color:#1E3A5F">@stats.TotalOrders</div>
        </div>
        <div class="fm-card" style="margin:0;padding:16px;text-align:center">
            <div style="font-size:12px;color:var(--fm-text-2)">Doanh số</div>
            <div style="font-size:28px;font-weight:700;color:#1E3A5F">@FmtMoney(stats.TotalRevenue)</div>
        </div>
        <div class="fm-card" style="margin:0;padding:16px;text-align:center">
            <div style="font-size:12px;color:var(--fm-text-2)">Đang mở</div>
            <div style="font-size:28px;font-weight:700;color:#F2B705">@stats.OpenOrders</div>
        </div>
        <div class="fm-card" style="margin:0;padding:16px;text-align:center">
            <div style="font-size:12px;color:var(--fm-text-2)">Đã đóng</div>
            <div style="font-size:28px;font-weight:700;color:#2e7d32">@stats.ClosedOrders</div>
        </div>
        <div class="fm-card" style="margin:0;padding:16px;text-align:center">
            <div style="font-size:12px;color:var(--fm-text-2)">Đã huỷ</div>
            <div style="font-size:28px;font-weight:700;color:#E0522F">@stats.CancelledOrders</div>
        </div>
    </div>

    @* Biểu đồ doanh thu 30 ngày *@
    <div class="fm-card" style="margin-bottom:14px">
        <h3 class="fm-card__title">Doanh số 30 ngày gần nhất</h3>
        <svg viewBox="0 0 600 220" style="width:100%;height:auto" role="img" aria-label="Biểu đồ doanh số 30 ngày">
            @for (int i = 0; i < stats.RevenueByDay.Count; i++)
            {
                var d = stats.RevenueByDay[i];
                var h = maxRevenue > 0 ? d.Revenue / maxRevenue * 160 : 0;
                var x = 20 + i * 19;
                <rect x="@x" y="@(180 - h)" width="14" height="@h" rx="2"
                      fill="@(d.Revenue > 0 ? "#1E3A5F" : "#e0e0e0")">
                    <title>@d.Date: @FmtMoney(d.Revenue) (@d.Orders đơn)</title>
                </rect>
                @if (i % 5 == 0)
                {
                    @((MarkupString)$"<text x=\"{x + 7}\" y=\"198\" font-size=\"9\" text-anchor=\"middle\" fill=\"#666\">{d.Date}</text>")
                }
            }
            <line x1="15" y1="180" x2="595" y2="180" stroke="#ccc" />
        </svg>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px">
        @* Top khách hàng *@
        <div class="fm-card" style="margin:0">
            <h3 class="fm-card__title">Top 5 khách hàng</h3>
            @if (stats.TopCustomers.Count == 0)
            {
                <p class="fm-hint">Chưa có dữ liệu.</p>
            }
            else
            {
                <table class="fm-table">
                    <thead><tr><th>Khách hàng</th><th class="fm-num">Đơn</th><th class="fm-num">Doanh số</th></tr></thead>
                    <tbody>
                        @foreach (var c in stats.TopCustomers)
                        {
                            <tr>
                                <td><b>@c.CardName</b><br /><span style="font-size:12px;color:var(--fm-text-2)">@c.CardCode</span></td>
                                <td class="fm-num">@c.Orders</td>
                                <td class="fm-num">@FmtMoney(c.Revenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        @* Top hàng hoá *@
        <div class="fm-card" style="margin:0">
            <h3 class="fm-card__title">Top 5 hàng hoá</h3>
            @if (stats.TopItems.Count == 0)
            {
                <p class="fm-hint">Chưa có dữ liệu.</p>
            }
            else
            {
                <table class="fm-table">
                    <thead><tr><th>Hàng hoá</th><th class="fm-num">SL</th><th class="fm-num">Doanh số</th></tr></thead>
                    <tbody>
                        @foreach (var it in stats.TopItems)
                        {
                            <tr>
                                <td><b>@it.ItemName</b><br /><span style="font-size:12px;color:var(--fm-text-2)">@it.ItemCode</span></td>
                                <td class="fm-num">@FmtQty(it.Quantity)</td>
                                <td class="fm-num">@FmtMoney(it.Revenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private DashboardStats? stats;
    private bool loading = true;
    private string? error;
    private double maxRevenue;

    protected override async Task OnInitializedAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        try
        {
            stats = await Api.GetDashboardStatsAsync();
            maxRevenue = stats?.RevenueByDay.Max(d => d.Revenue) ?? 0;
        }
        catch (ApiException ex)
        {
            if (ex.Status == 401) { await Auth.LogoutAsync(); Nav.NavigateTo("/login"); return; }
            error = ex.Message;
        }
        finally { loading = false; }
    }

    private static string FmtMoney(double n) =>
        n.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));

    private static string FmtQty(double n) =>
        n.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
}
