@page "/orders/{DocEntry:int}"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Chi tiết đơn — Sale Order</PageTitle>

@if (loading)
{
    <div style="color:var(--fm-text-3)">Đang tải…</div>
}
else if (!string.IsNullOrEmpty(error) && order is null)
{
    <div class="fm-alert fm-alert--error" role="alert">
        <div><b>Không tải được đơn hàng</b>@error</div>
    </div>
}
else if (order is not null)
{
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="fm-alert fm-alert--error" role="alert">
            <div><b>Thao tác thất bại</b>@error</div>
        </div>
    }

    <div class="fm-card" style="margin-bottom:14px">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px; flex-wrap:wrap">
            <a href="/" style="font-size:13px">← Danh sách</a>
            <h2 class="fm-card__title" style="margin:0">Đơn hàng #@order.DocNum</h2>
            <span class="fm-chip @StatusChip(order.Status)">@StatusLabel(order.Status)</span>
            <span style="flex:1"></span>
            @if (isOpen && Auth.HasRole("sales"))
            {
                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="() => editing = !editing">
                    Sửa ghi chú
                </FluentButton>
            }
            @if (isOpen && Auth.HasRole("manager"))
            {
                <FluentButton Appearance="ButtonAppearance.Outline" Disabled="busy" OnClick="CloseOrder">
                    Đóng đơn
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="busy" OnClick="CancelOrder"
                              Style="background:#E0522F">
                    Hủy đơn
                </FluentButton>
            }
        </div>

        <div class="fm-form-grid" style="row-gap:14px">
            <InfoRow Label="Khách hàng">
                <div>@order.CardName</div>
                <div style="font-size:11px; color:var(--fm-text-3); font-weight:400">@order.CardCode</div>
            </InfoRow>
            <InfoRow Label="Số PO của KH" Value="@order.NumAtCard" />
            <InfoRow Label="Ngày chứng từ" Value="@order.DocDate" />
            <InfoRow Label="Ngày giao hàng" Value="@order.DocDueDate" />
            <InfoRow Label="Ngày hạch toán" Value="@order.TaxDate" />
            <InfoRow Label="Tiền tệ / Tỷ giá" Value="@($"{order.Currency}{(order.DocRate != 1 ? $" ({order.DocRate})" : "")}")" />
            <InfoRow Label="Điều khoản thanh toán" Value="@PayTermName" />
            <InfoRow Label="Vận chuyển" Value="@ShipTypeName" />
            <InfoRow Label="Địa chỉ giao hàng" Value="@order.ShipToCode" />
            <InfoRow Label="Địa chỉ hoá đơn" Value="@order.PayToCode" />
            <InfoRow Label="Dự án" Value="@order.Project" />
            <InfoRow Label="Tổng tiền" Strong="true" Value="@($"{FmtMoney(order.DocTotal)} {order.Currency}")" />
        </div>

        <div style="margin-top:14px">
            <div style="font-size:11px; color:var(--fm-text-2); margin-bottom:4px">Ghi chú</div>
            @if (editing)
            {
                <div style="display:flex; gap:8px">
                    <FluentTextInput @bind-Value="comments" Style="flex:1" />
                    <FluentButton Appearance="ButtonAppearance.Primary" Disabled="busy" OnClick="SaveComments">Lưu</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="() => editing = false">Bỏ</FluentButton>
                </div>
            }
            else
            {
                <div style="font-size:13px">
                    @if (string.IsNullOrEmpty(order.Comments))
                    {
                        <span style="color:var(--fm-text-3)">—</span>
                    }
                    else
                    {
                        @order.Comments
                    }
                </div>
            }
        </div>
    </div>

    <div class="fm-table-wrap">
        <FluentDataGrid Items="@order.Lines.AsQueryable()" TGridItem="OrderLineOut" Style="width:100%">
            <TemplateColumn Title="#"><span>@(context.LineNum + 1)</span></TemplateColumn>
            <TemplateColumn Title="Hàng hoá">
                <div style="font-weight:600">@(string.IsNullOrEmpty(context.Description) ? context.ItemCode : context.Description)</div>
                <div style="font-size:11px; color:var(--fm-text-3)">@context.ItemCode</div>
            </TemplateColumn>
            <TemplateColumn Title="SL" Align="DataGridCellAlignment.End">
                <span style="font-variant-numeric:tabular-nums">@context.Quantity</span>
            </TemplateColumn>
            <TemplateColumn Title="Đơn giá" Align="DataGridCellAlignment.End">
                <span style="font-variant-numeric:tabular-nums">@FmtMoney(context.Price)</span>
            </TemplateColumn>
            <TemplateColumn Title="CK%" Align="DataGridCellAlignment.End">
                <span style="font-variant-numeric:tabular-nums">@context.DiscountPercent</span>
            </TemplateColumn>
            <PropertyColumn Property="@(l => l.Warehouse)" Title="Kho" />
            <TemplateColumn Title="Ngày giao">
                @(string.IsNullOrEmpty(context.ShipDate) ? "—" : context.ShipDate)
            </TemplateColumn>
            <TemplateColumn Title="Trạng thái dòng">
                @if (context.LineStatus == "bost_Open")
                {
                    <span class="fm-chip fm-chip--open">Đang mở</span>
                }
                else
                {
                    <span class="fm-chip fm-chip--closed">Đã đóng</span>
                }
            </TemplateColumn>
        </FluentDataGrid>
    </div>

    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick='() => Nav.NavigateTo("/")' Style="margin-top:12px">
        ← Về danh sách
    </FluentButton>
}

@code {
    [Parameter] public int DocEntry { get; set; }

    private OrderOut? order;
    private string? etag;
    private bool loading = true;
    private string error = "";
    private bool busy;
    private bool editing;
    private string comments = "";
    private List<PaymentTermOut> payTerms = new();
    private List<ShippingTypeOut> shipTypes = new();

    private bool isOpen => order?.Status == "open";
    private string PayTermName =>
        payTerms.FirstOrDefault(t => t.GroupNumber == order?.PaymentGroupCode)?.Name
        ?? (order?.PaymentGroupCode is int pg ? $"#{pg}" : "—");
    private string ShipTypeName =>
        shipTypes.FirstOrDefault(t => t.Code == order?.TransportationCode)?.Name
        ?? (order?.TransportationCode is int tc ? $"#{tc}" : "—");

    private static string StatusLabel(string s) => s switch
    {
        "open" => "Đang mở", "closed" => "Đã đóng", "cancelled" => "Đã hủy", _ => s,
    };
    private static string StatusChip(string s) => s switch
    {
        "open" => "fm-chip--open", "closed" => "fm-chip--closed", "cancelled" => "fm-chip--overdue",
        _ => "fm-chip--closed",
    };
    private static string FmtMoney(double n) =>
        n.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));

    protected override async Task OnParametersSetAsync()
    {
        _ = Api.ListPaymentTermsAsync().ContinueWith(t =>
        {
            if (t.Result is not null) { payTerms = t.Result; InvokeAsync(StateHasChanged); }
        });
        _ = Api.ListShippingTypesAsync().ContinueWith(t =>
        {
            if (t.Result is not null) { shipTypes = t.Result; InvokeAsync(StateHasChanged); }
        });
        await Load();
    }

    private async Task Load()
    {
        loading = true; error = "";
        try
        {
            var (o, e) = await Api.GetOrderAsync(DocEntry);
            order = o; etag = e;
            comments = o?.Comments ?? "";
        }
        catch (ApiException ex)
        {
            if (ex.Status == 401) { await Auth.LogoutAsync(); Nav.NavigateTo("/login"); return; }
            error = ex.Message;
        }
        finally { loading = false; }
    }

    private async Task Run(Func<Task<OrderOut?>> fn, string? confirmMsg, string? okMsg)
    {
        if (confirmMsg is not null && !await JS.InvokeAsync<bool>("confirm", confirmMsg)) return;
        busy = true; error = "";
        try
        {
            var updated = await fn();
            if (updated is not null) order = updated;
            if (okMsg is not null) await JS.InvokeVoidAsync("alert", okMsg);
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task SaveComments()
    {
        await Run(() => Api.UpdateOrderAsync(DocEntry, new OrderUpdate { Etag = etag, Comments = comments }),
            null, "Đã lưu ghi chú");
        editing = false;
    }

    private Task CloseOrder() =>
        Run(() => Api.CloseOrderAsync(DocEntry, null), "Đóng toàn bộ đơn hàng?", "Đã đóng đơn");

    private Task CancelOrder() =>
        Run(() => Api.CancelOrderAsync(DocEntry), "HỦY đơn hàng này? Không thể hoàn tác.", "Đã hủy đơn");
}
