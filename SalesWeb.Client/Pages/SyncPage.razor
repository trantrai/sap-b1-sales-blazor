@page "/sync"
@implements IDisposable
@inject ApiClient Api
@inject MasterDataCache MdCache
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Đồng bộ dữ liệu — Sale Order</PageTitle>

<div class="fm-card" style="margin-bottom:16px">
    <h2 class="fm-card__title">Đồng bộ master data từ SAP B1</h2>
    <p class="fm-card__desc" style="margin-bottom:0">
        SAP B1 là nguồn dữ liệu gốc. Hệ thống lưu bản sao <b>Khách hàng</b>,
        <b>Mặt hàng</b> và <b>Thuế suất</b> vào cơ sở dữ liệu local để tra cứu
        tức thì khi tạo đơn hàng (không phải gọi B1 mỗi lần gõ). Hãy đồng bộ
        lại khi master data trong B1 có thay đổi.
    </p>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="fm-alert fm-alert--error" role="alert"><div><b>Lỗi</b>@error</div></div>
}

<div class="fm-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px">
        <h2 class="fm-card__title" style="margin:0">Trạng thái đồng bộ</h2>
        @if (canSync)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="syncing" OnClick="@(() => Start(new() { "customers", "items", "tax_codes" }))"
                          IconStart="@(new Icons.Regular.Size20.ArrowSync())">
                @(syncing ? "Đang đồng bộ…" : "Đồng bộ tất cả")
            </FluentButton>
        }
    </div>
    <div class="fm-table-wrap">
        <FluentDataGrid EmptyContent="@emptySync" Items="@rows.AsQueryable()" TGridItem="SyncTableOut" Style="width:100%">
            <TemplateColumn Title="Dữ liệu">
                <span style="font-weight:600">@EntityLabel(context.Table)</span>
            </TemplateColumn>
            <TemplateColumn Title="Số bản ghi (local)" Align="DataGridCellAlignment.End">
                <span style="font-variant-numeric:tabular-nums">@context.Count.ToString("N0", ViVn)</span>
            </TemplateColumn>
            <TemplateColumn Title="Đồng bộ lần cuối">
                @(string.IsNullOrEmpty(context.LastSync) ? "—" : context.LastSync)
                @if (context.LastRecords > 0)
                {
                    <div style="font-size:11px; color:var(--fm-text-3)">
                        @context.LastRecords.ToString("N0", ViVn) bản ghi/lần
                    </div>
                }
            </TemplateColumn>
            <TemplateColumn Title="Trạng thái">
                @if (running)
                {
                    <span class="fm-chip fm-chip--open">Đang đồng bộ…</span>
                }
                else if (!string.IsNullOrEmpty(context.LastSync))
                {
                    <span class="fm-chip fm-chip--perm-c">Thành công</span>
                }
                else
                {
                    <span class="fm-chip fm-chip--closed">Chưa đồng bộ</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="">
                @if (canSync)
                {
                    <div style="text-align:right">
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      Disabled="@(syncing || running)"
                                      OnClick="@(() => Start(new() { context.Table }))">
                            Đồng bộ
                        </FluentButton>
                    </div>
                }
            </TemplateColumn>
        </FluentDataGrid>
    </div>
    @if (!canSync)
    {
        <p class="fm-hint" style="margin-top:10px">
            Chỉ tài khoản quản lý (manager/admin) mới được chạy đồng bộ.
        </p>
    }
</div>

@code {
    private static string EntityLabel(string entity) => entity switch
    {
        "customers" => "Khách hàng",
        "items" => "Hàng hoá",
        "tax_codes" => "Thuế suất",
        _ => entity,
    };
    private RenderFragment emptySync = @<div style="padding:18px;text-align:center;color:var(--fm-text-2)">Chưa có dữ liệu đồng bộ.</div>;
    private static readonly System.Globalization.CultureInfo ViVn =
        System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    private List<SyncTableOut> rows = new();
    private bool loading = true;
    private bool syncing;
    private bool running;
    private string error = "";
    private bool canSync;
    private System.Threading.Timer? pollTimer;

    protected override async Task OnInitializedAsync()
    {
        canSync = Auth.HasRole("manager");
        await Load();
    }

    private async Task Load()
    {
        try
        {
            var st = await Api.GetSyncStatusAsync();
            rows = st?.Tables ?? new();
            running = st?.Running ?? false;
        }
        catch (ApiException ex)
        {
            if (ex.Status == 401) { await Auth.LogoutAsync(); Nav.NavigateTo("/login"); return; }
            error = ex.Message;
        }
        finally { loading = false; }
    }

    private async Task Start(List<string> entities)
    {
        error = "";
        syncing = true;
        try
        {
            // P1 UI: lưu JobId và poll job scoped thay vì status global
            var start = await Api.TriggerSyncAsync(entities);
            var jobId = start?.JobId;
            await Load();
            pollTimer?.Dispose();
            pollTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    bool done = false;
                    if (!string.IsNullOrEmpty(jobId))
                    {
                        var job = await Api.GetSyncJobAsync(jobId);
                        done = job is null || job.Status != "running";
                        if (done && job?.Status == "error")
                            error = job.Error;
                    }
                    else
                    {
                        await Load();
                        done = !running;
                    }
                    if (done)
                    {
                        pollTimer?.Dispose();
                        pollTimer = null;
                        syncing = false;
                        await Load();
                        // Master data đã đổi → xoá cache client để lần tìm sau tải lại
                        MdCache.Invalidate();
                        StateHasChanged();
                    }
                });
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            syncing = false;
        }
    }

    public void Dispose() => pollTimer?.Dispose();
}
