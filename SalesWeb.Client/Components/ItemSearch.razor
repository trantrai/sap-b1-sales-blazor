@inject ApiClient Api

<FluentAutocomplete TOption="ItemOut" TValue="ItemOut"
                    OnOptionsSearch="OnSearch"
                    OptionText="@(i => $"{i.ItemCode} — {i.ItemName}")"
                    @bind-SelectedItem="Selected"
                    Placeholder="Gõ mã/tên hàng…"
                    MaximumOptionsSearch="20" />

@code {
    [Parameter] public ItemOut? Selected { get; set; }
    [Parameter] public EventCallback<ItemOut?> SelectedChanged { get; set; }

    private async Task OnSearch(OptionsSearchEventArgs<ItemOut> e)
    {
        e.Items = string.IsNullOrWhiteSpace(e.Text)
            ? Enumerable.Empty<ItemOut>()
            : await Api.SearchItemsAsync(e.Text) ?? new List<ItemOut>();
    }
}
